generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  OWNER
  TENANT
  RENTER
}

enum PropertyType {
  APARTMENT
  HOUSE
  VILLA
  STUDIO
  PLOT
  COMMERCIAL
}

enum Furnishing {
  UNFURNISHED
  SEMI_FURNISHED
  FULLY_FURNISHED
}

enum PropertyStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  ARCHIVED
  RENTED
  SOLD
}

enum Availability {
  AVAILABLE_NOW
  AVAILABLE_SOON
  NOT_AVAILABLE
}

enum EnquiryStatus {
  NEW
  CONTACTED
  VISIT_SCHEDULED
  NEGOTIATING
  CLOSED_WON
  CLOSED_LOST
}

enum AppointmentStatus {
  PROPOSED
  CONFIRMED
  RESCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(RENTER)
  phone        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens   RefreshToken[]
  propertiesOwned Property[]     @relation("PropertyOwner")
  favourites      Favourite[]
  enquiries       Enquiry[]

  @@index([role])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Property {
  id            String         @id @default(cuid())
  ownerId       String
  owner         User           @relation("PropertyOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  title         String
  description   String
  price         Decimal        @db.Decimal(12, 2)
  depositAmount Decimal?       @db.Decimal(12, 2)
  city          String
  locality      String
  address       String
  pincode       String?
  propertyType  PropertyType
  bedrooms      Int
  bathrooms     Int
  areaSqft      Int
  furnishing    Furnishing
  amenities     String[]       @default([])
  status        PropertyStatus @default(DRAFT)
  availability  Availability   @default(AVAILABLE_NOW)
  latitude      Float?
  longitude     Float?
  deletedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  images     PropertyImage[]
  favourites Favourite[]
  enquiries  Enquiry[]

  @@index([ownerId])
  @@index([city, locality])
  @@index([status, availability])
  @@index([price])
  @@index([bedrooms])
  @@index([propertyType])
  @@index([createdAt])
}

model PropertyImage {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  url        String
  publicId   String
  isPrimary  Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([propertyId])
}

model Favourite {
  userId     String
  propertyId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([userId, propertyId])
  @@index([userId])
  @@index([propertyId])
}

model Enquiry {
  id         String        @id @default(cuid())
  userId     String
  propertyId String
  message    String
  status     EnquiryStatus @default(NEW)
  ownerNotes String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  property     Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([userId])
  @@index([propertyId])
  @@index([status])
}

model Appointment {
  id        String            @id @default(cuid())
  enquiryId String
  visitAt   DateTime
  status    AppointmentStatus @default(PROPOSED)
  notes     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  enquiry Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)

  @@index([enquiryId])
  @@index([status])
  @@index([visitAt])
}
