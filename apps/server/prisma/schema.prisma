generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  OWNER
  TENANT
  RENTER
}

enum PropertyType {
  APARTMENT
  HOUSE
  VILLA
  STUDIO
  PLOT
  COMMERCIAL
}

enum Furnishing {
  UNFURNISHED
  SEMI_FURNISHED
  FULLY_FURNISHED
}

enum PropertyStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  ARCHIVED
  RENTED
  SOLD
}

enum Availability {
  AVAILABLE_NOW
  AVAILABLE_SOON
  NOT_AVAILABLE
}

enum EnquiryStatus {
  NEW
  CONTACTED
  VISIT_SCHEDULED
  NEGOTIATING
  CLOSED_WON
  CLOSED_LOST
}

enum AppointmentStatus {
  PROPOSED
  CONFIRMED
  RESCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum LeaseStatus {
  DRAFT
  PENDING_ACCEPTANCE
  ACTIVE
  ENDED
  TERMINATED
}

enum LeaseAcceptanceStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum PaymentMethod {
  UPI
  CASH
  BANK_TRANSFER
  OTHER
}

enum MaintenanceStatus {
  SUBMITTED
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationType {
  ENQUIRY_RECEIVED
  APPOINTMENT_SCHEDULED
  APPOINTMENT_CONFIRMED
  LEASE_CREATED
  LEASE_ACCEPTED
  LEASE_ENDING_SOON
  LEASE_ENDED
  RENT_DUE_SOON
  RENT_OVERDUE
  PAYMENT_RECORDED
  MAINTENANCE_SUBMITTED
  MAINTENANCE_UPDATED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(RENTER)
  phone        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens       RefreshToken[]
  propertiesOwned     Property[]           @relation("PropertyOwner")
  favourites          Favourite[]
  enquiries           Enquiry[]
  leasesAsTenant      Lease[]              @relation("LeaseTenant")
  maintenanceAsTenant MaintenanceRequest[] @relation("MaintenanceTenant")
  maintenanceUpdates  MaintenanceUpdate[]  @relation("MaintenanceUpdateAuthor")
  notifications       Notification[]
  auditLogs           AuditLog[]

  @@index([role])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Property {
  id            String         @id @default(cuid())
  ownerId       String
  owner         User           @relation("PropertyOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  title         String
  description   String
  price         Decimal        @db.Decimal(12, 2)
  depositAmount Decimal?       @db.Decimal(12, 2)
  city          String
  locality      String
  address       String
  pincode       String?
  propertyType  PropertyType
  bedrooms      Int
  bathrooms     Int
  areaSqft      Int
  furnishing    Furnishing
  amenities     String[]       @default([])
  status        PropertyStatus @default(DRAFT)
  availability  Availability   @default(AVAILABLE_NOW)
  latitude      Float?
  longitude     Float?
  activeLeaseId String?
  deletedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  images              PropertyImage[]
  favourites          Favourite[]
  enquiries           Enquiry[]
  leases              Lease[]
  maintenanceRequests MaintenanceRequest[]

  @@index([ownerId])
  @@index([city, locality])
  @@index([status, availability])
  @@index([price])
  @@index([bedrooms])
  @@index([propertyType])
  @@index([createdAt])
  @@index([status, activeLeaseId])
}

model PropertyImage {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  url        String
  publicId   String
  isPrimary  Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([propertyId])
}

model Favourite {
  userId     String
  propertyId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([userId, propertyId])
  @@index([userId])
  @@index([propertyId])
}

model Enquiry {
  id         String        @id @default(cuid())
  userId     String
  propertyId String
  message    String
  status     EnquiryStatus @default(NEW)
  ownerNotes String?
  leaseId    String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  property     Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  leases       Lease[]

  @@index([userId])
  @@index([propertyId])
  @@index([status])
}

model Appointment {
  id        String            @id @default(cuid())
  enquiryId String
  visitAt   DateTime
  status    AppointmentStatus @default(PROPOSED)
  notes     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  enquiry Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)

  @@index([enquiryId])
  @@index([status])
  @@index([visitAt])
}

model Lease {
  id                 String                @id @default(cuid())
  propertyId         String
  tenantId           String
  enquiryId          String?
  startDate          DateTime
  endDate            DateTime
  rentAmount         Decimal               @db.Decimal(12, 2)
  depositAmount      Decimal?              @db.Decimal(12, 2)
  dueDay             Int
  status             LeaseStatus           @default(DRAFT)
  documentUrl        String?
  acceptanceStatus   LeaseAcceptanceStatus @default(PENDING)
  acceptedByTenantAt DateTime?
  acceptedByName     String?
  signatureDataUrl   String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  property        Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant          User                 @relation("LeaseTenant", fields: [tenantId], references: [id], onDelete: Cascade)
  enquiry         Enquiry?             @relation(fields: [enquiryId], references: [id], onDelete: SetNull)
  rentObligations RentObligation[]
  payments        Payment[]
  maintenance     MaintenanceRequest[]

  @@index([propertyId, status])
  @@index([tenantId, status])
  @@index([endDate])
  @@index([status, endDate])
}

model RentObligation {
  id         String   @id @default(cuid())
  leaseId    String
  dueDate    DateTime
  amountDue  Decimal  @db.Decimal(12, 2)
  amountPaid Decimal  @default(0) @db.Decimal(12, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  lease              Lease               @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  paymentAllocations PaymentAllocation[]

  @@unique([leaseId, dueDate])
  @@index([leaseId, dueDate])
  @@index([dueDate])
  @@index([dueDate, leaseId])
}

model Payment {
  id         String        @id @default(cuid())
  leaseId    String
  amount     Decimal       @db.Decimal(12, 2)
  paidAt     DateTime      @default(now())
  method     PaymentMethod
  reference  String?
  recordedBy String?
  notes      String?
  createdAt  DateTime      @default(now())

  lease              Lease               @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  paymentAllocations PaymentAllocation[]

  @@index([leaseId, paidAt])
}

model PaymentAllocation {
  id               String   @id @default(cuid())
  paymentId        String
  rentObligationId String
  amount           Decimal  @db.Decimal(12, 2)
  createdAt        DateTime @default(now())

  payment        Payment        @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  rentObligation RentObligation @relation(fields: [rentObligationId], references: [id], onDelete: Cascade)

  @@unique([paymentId, rentObligationId])
  @@index([rentObligationId])
}

model MaintenanceRequest {
  id            String              @id @default(cuid())
  propertyId    String
  tenantId      String
  leaseId       String
  title         String
  description   String
  imageUrl      String?
  imagePublicId String?
  status        MaintenanceStatus   @default(SUBMITTED)
  priority      MaintenancePriority @default(MEDIUM)
  resolvedAt    DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  property Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant   User                @relation("MaintenanceTenant", fields: [tenantId], references: [id], onDelete: Cascade)
  lease    Lease               @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  updates  MaintenanceUpdate[]

  @@index([propertyId, status])
  @@index([tenantId, status])
  @@index([leaseId])
  @@index([createdAt])
  @@index([status, createdAt])
}

model MaintenanceUpdate {
  id        String             @id @default(cuid())
  requestId String
  updatedBy String
  oldStatus MaintenanceStatus?
  newStatus MaintenanceStatus
  note      String?
  createdAt DateTime           @default(now())

  request MaintenanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user    User               @relation("MaintenanceUpdateAuthor", fields: [updatedBy], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([entity, entityId])
  @@index([createdAt])
}
