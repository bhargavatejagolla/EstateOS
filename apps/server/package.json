    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@estateos/shared": "workspace:*",
    "@prisma/client": "7.5.0",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "5.3.0",
    "helmet": "8.0.0",
    "zod": "4.6.0"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "5.0.0",
    "@types/node": "22.10.5",
    "prisma": "7.5.0",
    "tsx": "4.19.2",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
