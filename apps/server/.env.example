# ── Server Configuration ───────────────────────────
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# ── Database (PostgreSQL / Neon) ───────────────────
# Paste a PostgreSQL connection string (e.g. from Neon.tech, Supabase, or local PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-xxx.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_TEST="postgresql://USER:PASSWORD@ep-xxx-xxx.region.aws.neon.tech/neondb?sslmode=require"

# ── Authentication Secrets (min 16 characters) ────
JWT_ACCESS_SECRET="estateos_super_secure_access_secret_123456"
JWT_REFRESH_SECRET="estateos_super_secure_refresh_secret_123456"
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── Optional: Cloudinary ───────────────────────────
# If omitted, uploaded property photos are automatically stored locally in apps/server/uploads
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
