# EstateOS Environment Configuration Template

# Server Configuration
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Database Connection
# Local PostgreSQL default: postgresql://postgres:<password>@localhost:5432/estateos_dev?schema=public
# Cloud PostgreSQL (Neon / Supabase): postgresql://<user>:<password>@<host>/<dbname>?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/estateos_dev?schema=public

# Authentication Secrets (Generate secure 64-char hex strings in production)
JWT_ACCESS_SECRET=super_secret_estateos_access_token_key_change_in_production
JWT_REFRESH_SECRET=super_secret_estateos_refresh_token_key_change_in_production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Media Uploads (Cloudinary - Phase 2)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Vite Client Environment Variables
VITE_API_URL=http://localhost:4000/api
