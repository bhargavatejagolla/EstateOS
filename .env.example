# ── Server ────────────────────────────────────────
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# ── Database (Neon) ───────────────────────────────
# Paste the DIRECT connection string from your Neon dashboard.
# Format: postgresql://<user>:<password>@<endpoint>.region.aws.neon.tech/neondb?sslmode=require
# For Phase 1, use DIRECT (not pooled). We add pooling in Phase 2 if needed.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-xxx.region.aws.neon.tech/neondb?sslmode=require"

# ── Auth (used from Phase 2; fill now so .env is complete) ──
# Windows has no openssl. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace_me_64_hex_chars
JWT_REFRESH_SECRET=replace_me_64_hex_chars
